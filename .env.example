# NeuroPilot suite configuration (copy to .env and adjust).
# Component-internal settings (topic names, tolerances, MEP windows) live in
# each component's config.py; this file holds what must agree across them.

# Relay endpoint all components connect to.
RELAY_HOST=127.0.0.1
RELAY_PORT=5000

# Data folder for controller results (must be writable; replaced the
# cluster-only default that crashed local imports).
#ROOT_FOLDER=~/.neuropilot

# Seconds to wait for a component's readiness probe.
#READINESS_TIMEOUT_S=60

# Real mode: path to a tms-robot-control checkout (for --launch-relay).
#TMS_ROBOT_CONTROL_PATH=

# MuJoCo viewer override (Wayland machines; auto-detected if unset).
#PYGLFW_LIBRARY=

# ── Controller-specific (forwarded to the controller package) ───────────────
ENABLE_HEALTH_CHECK_AND_CONTROL_PANEL=false

# Virtual EMG channel names and count (comma separated; the cortical
# sources per channel are configured in the project window)
EMG_CHANNELS=FDI,APB,ADM
