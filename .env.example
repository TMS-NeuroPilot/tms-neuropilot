# NeuroPilot suite configuration (copy to .env and adjust).
# Component-internal settings (topic names, tolerances, MEP windows) live in
# each component's config.py; this file holds what must agree across them.
#
# The hardware settings below are ALSO editable in Config > Lab, which writes
# them to ~/.neuropilot/lab.yaml (NEUROPILOT_LAB_FILE moves that file).
# Precedence, highest first:
#     shell environment  >  this .env  >  lab.yaml  >  built-in defaults
# so a key kept (uncommented) here pins that value on this machine.

# Relay endpoint all components connect to.
RELAY_HOST=127.0.0.1
RELAY_PORT=5000

# Data folder for controller results (must be writable; replaced the
# cluster-only default that crashed local imports).
#ROOT_FOLDER=~/.neuropilot

# Seconds to wait for a component's readiness probe.
#READINESS_TIMEOUT_S=60

# Real mode: path to a tms-robot-control checkout. When set, the production
# relay is started automatically in real/manual/training if it is not running.
#TMS_ROBOT_CONTROL_PATH=

# InVesalius auto-start for real/manual/training. These live in
# ~/.neuropilot/lab.yaml after discovery; set them here to pin one machine.
#INVESALIUS_LAUNCH=auto
# Use "external" when InVesalius runs on another machine and connects to the
# relay itself; the picker's "Is started" button writes this value.
#INVESALIUS_ENV=
#INVESALIUS_CHECKOUT=
#INVESALIUS_LAUNCHER=

# MuJoCo viewer override (Wayland machines; auto-detected if unset).
#PYGLFW_LIBRARY=

# ── Controller-specific (forwarded to the controller package) ───────────────
# true = run the GUI and the health-check loop (normal use).
# false is only for tests of individual parts: without a control panel the
# experiment loop has no target file and never starts.
ENABLE_HEALTH_CHECK_AND_CONTROL_PANEL=true

# Where the MEP and pre-activation plots are written (relative to ROOT_FOLDER).
EMG_PLOTS_FOLDER_PATH=emg_plots
P2P_PLOTS_FOLDER_PATH=p2p_plots

# MEP extraction windows (pynibs). TMS_PULSE_TIME is in tenths of a second
# (5 -> 0.5 s); the rest are samples.
TMS_PULSE_TIME=5
START_MEP=10
END_MEP=100
MEASUREMENT_START_TIME=0
SAMPLING_RATE=4000
CUTOFF_FREQ=500

# Simulated robot model (see sim_robot/config.py ROBOT_MJCF for options).
#ROBOT=omron

# Movement limits.  These use the same names and units as
# tms-robot-control/.env.  SAFE_HEIGHT is millimetres above the robot base;
# the thresholds are the largest per-axis translation (mm) and rotation
# (degrees) that still allow a direct move.  Larger changes take the
# safe-height path.
SAFE_HEIGHT=350
TRANSLATION_THRESHOLD=20
ROTATION_THRESHOLD=15

# Real stimulator serial + TTL ports.  Built-in defaults are platform-aware:
# Linux uses /dev/ttyS1 + /dev/parport0; on Windows serial is COM* (set it
# explicitly, e.g. COM3) and there is no default TTL line.
#STIMULATOR_PORT=/dev/ttyS1
#STIMULATOR_TTL_PORT=/dev/parport0

# Online E-field solver (pardiso is the fast default) and anisotropy type.
#ONLINE_FEM_SOLVER=pardiso
#ONLINE_FEM_ANISOTROPY=scalar

# Real EMG computer (CED 1401 / Signal share over SMB).
#EMG_COMPUTER_IP=192.168.1.2
#EMG_COMPUTER_USERNAME=neuro
#EMG_COMPUTER_PASSWORD=
# Keep the initial SMB connect short so an offline EMG PC cannot delay the
# controller GUI for the smbclient default of 60 seconds.
#EMG_CONNECT_TIMEOUT_S=3

# Virtual EMG channel names and count (comma separated; the cortical
# sources per channel are configured in the project window)
EMG_CHANNELS=FDI,APB,ADM

# Simulated MEP tuning (virtual EMG only). Noise is the standard deviation
# added to the trace in mV. MT is the no-response cutoff; UPPER_LIMIT is the
# field mapped to 100% of the TVS recruitment curve.
#VIRTUAL_MEP_NOISE_MV=0.001
#VIRTUAL_MEP_TRIAL_VARIABILITY=true
#VIRTUAL_MEP_MT=60
#VIRTUAL_MEP_UPPER_LIMIT=100
#VIRTUAL_MEP_EFIELD_SCALE=1.4
