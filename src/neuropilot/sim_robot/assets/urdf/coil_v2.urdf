<?xml version="1.0"?>
<robot name="coil">
  <link name="world"/>
  <joint name="fixed" type="fixed">
    <parent link="world"/>
    <child link="coil_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="coil_link">
    <visual>
      <geometry>
        <mesh filename="../meshes/coil/mock_coil_v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../meshes/coil/mock_coil_v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
</robot>
