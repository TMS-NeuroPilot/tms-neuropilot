<mujoco model="tms_scene">
  <compiler angle="radian" meshdir="../meshes/"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <default>
    <joint armature="0.1" damping="0.1"/>
    <geom condim="4"/>
    <default class="robot_joint">
      <joint armature="0.05"/>
      <general input="pos" biastype="affine" gainprm="400" biasprm="0 -400 -10"/>
    </default>
  </default>

  <asset>
    <texture type="cube" colorspace="auto" name="tex_robot" builtin="flat" rgb2="0.8 0.8 0.8" width="512" height="3072"/>
    <texture type="cube" colorspace="auto" name="tex_skin" builtin="flat" rgb1="1 0.8 0.7" rgb2="1 0.8 0.7" width="512" height="3072"/>
    <texture type="skybox" colorspace="auto" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="1 1 1" width="512" height="3072"/>
    <texture type="2d" colorspace="auto" name="tex_checker" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="mat_grey" texture="tex_robot" shininess="0.3" rgba="0.5 0.5 0.5 1"/>
    <material name="mat_green" texture="tex_robot" shininess="0.3" rgba="0 0.8 0 1"/>
    <material name="mat_coil" texture="tex_robot" specular="0.6" shininess="0.4" rgba="0.4 0.4 0.4 1"/>
    <material name="mat_skin" texture="tex_skin" specular="0.3" shininess="0.2" rgba="1 0.8 0.7 1"/>
    <material name="mat_checker" texture="tex_checker" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
    <mesh name="vis_base" content_type="model/stl" file="robot/tm5-900/visual/tm5-base.stl"/>
    <mesh name="vis_link1" content_type="model/stl" file="robot/tm5-900/visual/tmr_400w_01_conv.stl"/>
    <mesh name="vis_link2" content_type="model/stl" file="robot/tm5-700/visual/tm5-700_arm1_conv.stl"/>
    <mesh name="vis_link3" content_type="model/stl" file="robot/tm5-700/visual/tm5-700_arm2_conv.stl"/>
    <mesh name="vis_link4" content_type="model/stl" file="robot/tm5-900/visual/tmr_100w_01.stl"/>
    <mesh name="vis_link5" content_type="model/stl" file="robot/tm5-900/visual/tmr_100w_02.stl"/>
    <mesh name="vis_link6" content_type="model/stl" file="robot/tm5-900/visual/tmr_iox_conv.stl"/>
    <mesh name="vis_coil" content_type="model/stl" file="coil/B65_with_Case_v2.7.stl" scale="0.001 0.001 0.001"/>
    <mesh name="col_base" content_type="model/stl" file="robot/tm5-900/collision/tm5-base_c.stl"/>
    <mesh name="col_link1" content_type="model/stl" file="robot/tm5-900/collision/tmr_400w_01_c.stl"/>
    <mesh name="col_link2" content_type="model/stl" file="robot/tm5-700/collision/tm5-700_arm1_c.stl"/>
    <mesh name="col_link3" content_type="model/stl" file="robot/tm5-700/collision/tm5-700_arm2_c.stl"/>
    <mesh name="col_link4" content_type="model/stl" file="robot/tm5-900/collision/tmr_100w_01_c.stl"/>
    <mesh name="col_link5" content_type="model/stl" file="robot/tm5-900/collision/tmr_100w_02_c.stl"/>
    <mesh name="col_link6" content_type="model/stl" file="robot/tm5-900/collision/tmr_iox_c.stl"/>
    <mesh name="col_coil" content_type="model/stl" file="coil/B65_with_Case_v2.7.stl" scale="0.001 0.001 0.001"/>
    <mesh name="head_mesh" content_type="model/stl" file="head/head88.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" pos="0 0 -1" type="plane" material="mat_checker"/>
    <geom name="axis_x" size="0.005 0.15" pos="0.15 0 0" quat="0.707107 0 -0.707107 0" type="capsule" contype="0" conaffinity="0" rgba="1 0 0 1"/>
    <geom name="axis_y" size="0.005 0.15" pos="0 0.15 0" quat="0.707107 0.707107 0 0" type="capsule" contype="0" conaffinity="0" rgba="0 1 0 1"/>
    <geom name="axis_z" size="0.005 0.15" pos="0 0 0.15" quat="0 1 0 0" type="capsule" contype="0" conaffinity="0" rgba="0 0 1 0.5"/>
    <light pos="0 0 1.5" type="directional"/>
    <body name="link_0">
      <inertial pos="0 0 0" mass="1" diaginertia="0.00110833 0.00110833 0.0018"/>
      <geom name="g_base_vis" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_green" mesh="vis_base"/>
      <geom name="g_base_col" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_base"/>
      <body name="link_1" pos="0 0 0.1452">
        <inertial pos="0 0 0" mass="4.032" diaginertia="0.00880012 0.011549 0.0119701"/>
        <joint name="joint_1" range="-6.28319 6.28319"/>
        <geom name="g_link1_vis" type="mesh" contype="0" conaffinity="0" material="mat_grey" mesh="vis_link1"/>
        <geom name="g_link1_col" type="mesh" rgba="0 0 0 0" mesh="col_link1"/>
        <body name="link_2" quat="0.5 -0.5 -0.5 -0.5">
          <inertial pos="0 0 0" mass="8.567" diaginertia="0.0235521 0.198252 0.204593"/>
          <joint name="joint_2" range="-6.28319 6.28319"/>
          <geom name="g_link2_vis" pos="0 0 0" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_grey" mesh="vis_link2"/>
          <geom name="g_link2_col" pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_link2"/>
          <body name="link_3" pos="0.329 0 0">
            <inertial pos="0 0 0" mass="2.273" diaginertia="0.00338018 0.0338291 0.0343282"/>
            <joint name="joint_3" range="-2.70526 2.70526"/>
            <geom name="g_link3_vis" pos="0 0 0" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_grey" mesh="vis_link3"/>
            <geom name="g_link3_col" pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_link3"/>
            <body name="link_4" pos="0.3115 0 -0.1223" quat="0.707107 0 0 0.707107">
              <inertial pos="0 0 0" mass="1.576" diaginertia="0.00205841 0.00256308 0.00264321"/>
              <joint name="joint_4" range="-6.28319 6.28319"/>
              <geom name="g_link4_vis" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_grey" mesh="vis_link4"/>
              <geom name="g_link4_col" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_link4"/>
              <body name="link_5" pos="0 -0.106 0" quat="0.707107 0.707107 0 0">
                <inertial pos="0 0 0" mass="1.576" diaginertia="0.00205841 0.00256308 0.00264321"/>
                <joint name="joint_5" range="-6.28319 6.28319"/>
                <geom name="g_link5_vis" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_grey" mesh="vis_link5"/>
                <geom name="g_link5_col" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_link5"/>
                <body name="link_6" pos="0 -0.11315 0" quat="0.707107 0.707107 0 0">
                  <inertial pos="0 0 0" mass="0.31" diaginertia="0.000226642 0.000226642 0.000286595"/>
                  <joint name="joint_6" range="-6.28319 6.28319"/>
                  <geom name="g_link6_vis" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" material="mat_green" mesh="vis_link6"/>
                  <geom name="g_link6_col" quat="1 0 0 0" type="mesh" rgba="0 0 0 0" mesh="col_link6"/>
                  <body name="flange">
                    <inertial pos="-0.010338 0.010567 0.061388" quat="0.46666 0.466845 -0.610485 0.437713" mass="1.909" diaginertia="0.0110968 0.00785972 0.00646348"/>
                    <geom name="g_coil_vis" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" conaffinity="0" material="mat_coil" mesh="vis_coil"/>
                    <geom name="g_coil_col" quat="0.707105 0 0 -0.707108" type="mesh" rgba="0 0 0 0" mesh="col_coil"/>
                    <site name="coil_tcp_site" pos="0 0 0.1108"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="head_link" pos="0.4 -0.4 0" quat="0.707107 0 0 -0.707107">
      <inertial pos="0 0 0" mass="4.5" diaginertia="0.016 0.016 0.016"/>
      <geom name="g_head" quat="1 0 0 0" type="mesh" material="mat_skin" mesh="head_mesh"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="link_0" body2="link_1"/>
    <exclude body1="link_1" body2="link_2"/>
    <exclude body1="link_2" body2="link_3"/>
    <exclude body1="link_3" body2="link_4"/>
    <exclude body1="link_4" body2="link_5"/>
    <exclude body1="link_5" body2="link_6"/>
    <exclude body1="link_6" body2="flange"/>
  </contact>

  <actuator>
    <general name="act_joint_1" class="robot_joint" joint="joint_1" gainprm="200" biasprm="0 -200"/>
    <general name="act_joint_2" class="robot_joint" joint="joint_2" gainprm="200" biasprm="0 -200"/>
    <general name="act_joint_3" class="robot_joint" joint="joint_3" gainprm="200" biasprm="0 -200"/>
    <general name="act_joint_4" class="robot_joint" joint="joint_4" gainprm="200" biasprm="0 -200"/>
    <general name="act_joint_5" class="robot_joint" joint="joint_5" gainprm="200" biasprm="0 -200"/>
    <general name="act_joint_6" class="robot_joint" joint="joint_6" gainprm="200" biasprm="0 -200"/>
  </actuator>
</mujoco>
