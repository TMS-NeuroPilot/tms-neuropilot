           <property name="styleSheet">
            <string notr="true">/* Main ComboBox Style */
QComboBox {
    border: 2px solid #5dade2;   /* Matches your QLineEdit border */
    border-radius: 6px;          /* Matches your button corners */
    padding: 5px 10px;
    background-color: #ffffff;   /* Clean white background */
    color: #333333;              /* Dark text for contrast */
    font-size: 13px;             /* Consistent font size */
    min-width: 6em;
}

/* Hover Effect */
QComboBox:hover {
    border-color: #4A90E2;       /* Bright blue from your buttons */
}

/* Dropdown Button Area */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    
    /* Create a distinct box for the arrow */
    border-left-width: 1px;
    border-left-color: #5dade2;
    border-left-style: solid; 
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    
    background: #e6eef5;         /* Light blue background (matches your Tabs) */
}

/* Hover Effect on Dropdown Button */
QComboBox::drop-down:hover {
    background: #d0d9e6;
}

/* The Arrow Icon */
/* We use the standard Qt arrow you used in your SpinBox styling */
/* QComboBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowdown.png);
    width: 12px;
    height: 12px;
}*/

/* The Popup List (Dropdown Menu) */
QComboBox QAbstractItemView {
    border: 2px solid #5dade2;   /* Consistent border */
    background-color: #ffffff;   /* White background */
    selection-background-color: #4A90E2; /* Blue selection matches buttons */
    selection-color: white;      /* White text on selection */
    outline: 0px;                /* Remove dotted line on focus */
    border-radius: 0px 0px 6px 6px;
}</string>
