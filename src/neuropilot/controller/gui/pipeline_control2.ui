           <property name="styleSheet">
            <string notr="true">/* Base look */
QAbstractSpinBox {
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #f9f9f9;
    padding: 4px 28px 4px 8px;   /* room on the right for buttons */
    font-size: 13px;
    selection-background-color: #4CAF50;
    selection-color: white;
}

/* Up/Down button geometry */
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 22px;                 /* make sure they’re visible */
    border-left: 1px solid #ccc;
    background: #5DE2E7;
}

/* Split top/bottom */
QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
    height: 14,5%;
}
QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
    height: 14,5%;
}

/* Hover */
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background: #dcdcdc;
}

/* Keep the arrows (use Qt’s built‑ins) */
QAbstractSpinBox::up-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowup.png);
    width: 10px; height: 10px;
}
QAbstractSpinBox::up-arrow:disabled {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowup_disabled.png);
}
QAbstractSpinBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowdown.png);
    width: 10px; height: 10px;
}
QAbstractSpinBox::down-arrow:disabled {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowdown_disabled.png);
}
</string>
