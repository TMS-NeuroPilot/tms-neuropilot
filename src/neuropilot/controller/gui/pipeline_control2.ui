    border: 1px solid rgba(0,0,0,160);  /* rim */
	background-color: qradialgradient(
        cx:0.35, cy:0.35, radius:0.6,
        fx:0.35, fy:0.35,
        stop:0 rgba(255,255,255,80),     /* tiny specular highlight */
        stop:0.4 rgba(70,70,70,140),
        stop:1 rgba(30,30,30,255)
    );
}

/* OFF state (dim) */
QLabel#led_robot[status=&quot;off&quot;] {
    background-color: qradialgradient(
        cx:0.35, cy:0.35, radius:0.6,
        fx:0.35, fy:0.35,
        stop:0 rgba(255,255,255,80),     /* tiny specular highlight */
        stop:0.4 rgba(70,70,70,140),
        stop:1 rgba(30,30,30,255)
    );
}

/* ON - GREEN */
QLabel#led_robot[status=&quot;on&quot;][color=&quot;green&quot;] {
    background-color: qradialgradient(
        cx:0.35, cy:0.35, radius:0.6,
        fx:0.35, fy:0.35,
        stop:0 rgba(255,255,255,230),
        stop:0.35 rgba(160,255,160,235),
        stop:0.75 rgba(0,170,0,240),
        stop:1 rgba(0,95,0,255)
    );
}

/* ON - RED */
QLabel#led_robot[status=&quot;on&quot;][color=&quot;red&quot;] {
    background-color: qradialgradient(
        cx:0.35, cy:0.35, radius:0.6,
        fx:0.35, fy:0.35,
        stop:0 rgba(255,255,255,230),
        stop:0.35 rgba(255,180,180,235),
        stop:0.75 rgba(200,0,0,240),
        stop:1 rgba(110,0,0,255)
    );
}

/* ON - YELLOW */
QLabel#led_robot[status=&quot;on&quot;][color=&quot;yellow&quot;] {
    background-color: qradialgradient(
        cx:0.35, cy:0.35, radius:0.6,
        fx:0.35, fy:0.35,
        stop:0 rgba(255,255,255,230),
        stop:0.35 rgba(255,250,170,235),
        stop:0.75 rgba(210,170,0,240),
        stop:1 rgba(130,95,0,255)
    );
}
