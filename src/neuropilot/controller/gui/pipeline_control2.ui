            <height>121</height>
           </rect>
          </property>
          <property name="styleSheet">
           <string notr="true">QGroupBox {
    font-size: 13px;
    font-weight: bold;
    border: 2px solid #5dade2; /* Matches your QLineEdit borders */
    border-radius: 8px;
    margin-top: 25px; /* Creates vertical space so the title doesn't clip */
    padding-top: 10px; /* Inner spacing so content doesn't hit the border */
    background-color: #ffffff; /* Clean white background */
}

QGroupBox::title {
    subcontrol-origin: margin; /* Places the title in the margin area */
    subcontrol-position: top left;
    padding: 0 10px; /* Adds breathing room around the text */
    left: 10px; /* Indents the title slightly from the left edge */
    color: #4A90E2; /* Matches your primary button text color */
    background-color: transparent;
}</string>
          </property>
          <property name="title">
           <string>Default Parameters</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignCenter</set>
          </property>
          <widget class="QPushButton" name="load_yaml">
           <property name="geometry">
            <rect>
             <x>20</x>
             <y>40</y>
             <width>111</width>
             <height>61</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">/* Basic style for QPushButton */
QPushButton {
    background-color: #4A90E2; /* Light blue background */
    color: white; /* White text */
    border: 2px solid #4A90E2; /* Light blue border */
    border-radius: 12px; /* Rounded corners */
    padding: 5px 20px; /* Vertical and horizontal padding */
    font-size: 13px; /* Font size */
    font-weight: bold; /* Bold text */
    text-align: center;
    outline: none; /* Remove the focus outline */

}

/* Hover effect for QPushButton */
QPushButton:hover {
    background-color: #357ABD; /* Darker blue on hover */
    border-color: #357ABD; /* Darker blue border on hover */

}

/* Pressed (active) effect for QPushButton */
QPushButton:pressed {
    background-color: #2C6BA3; /* Even darker blue when pressed */
    border-color: #1F4A7A; /* Darker blue border when pressed */

}

/* Focus effect (when button is focused) */
QPushButton:focus {
    outline: none; /* Remove the default focus outline */
}

