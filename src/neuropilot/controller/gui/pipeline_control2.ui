           <property name="styleSheet">
            <string notr="true">QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #d0d0d0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #4CAF50;
    border: none;
    height: 18px;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #45a049;
}

QSlider::sub-page:horizontal {
    background: #4CAF50;
    border-radius: 3px;
}
</string>
