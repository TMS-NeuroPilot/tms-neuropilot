       <widget class="QTabWidget" name="tabWidget">
        <property name="styleSheet">
         <string notr="true">/* Style for the Tab Widget */
QTabWidget {
    background-color: #f4f7fa; /* Light background for the widget */
    border: none;
    padding: 5px;
}

/* Style for the Tab Bar (the row of tabs) */
QTabBar {
  /* background-color: #ffffff; /* White tab bar */
    border: none;
    border-radius: 5px;
    padding: 5px;
    margin: 0;

}

/* Style for each individual tab */
QTabBar::tab {
    width: 120px; /* Width of the tab */
    background-color: #e6eef5; /* Light background for the tabs */
    color: #333333; /* Dark text color for readability */
    padding: 6px 10px; /* Adjust vertical padding to 8px (top and bottom) */
    border-radius: 5px;
    /*margin-right: 5px;
	margin-top:5px;*/
	margin:5px;
    font-size: 16px;
    line-height: 1.2; /* Ensures line height doesn't cause clipping */
    border: 1px solid #d1d9e6;

    min-height: 23px; /* Ensure the tab height is enough */
    text-align: center; /* Center the text horizontally */
    vertical-align: middle; /* Vertically align the text inside the tab */
}

/* Hover effect for tabs */
QTabBar::tab:hover {
    background-color: #b3c8e3; /* Slightly darker blue on hover */
    color: #333333; /* Keep the text dark for contrast */
}

/* Style for the active tab (the selected one) */
QTabBar::tab:selected {
    background-color: #007bff; /* Bright blue for the selected tab */
    color: white;
    border-color: #007bff;
}

/* Style for the content area (when tab is active) */
QTabWidget::pane {
    border: none;
    background-color: #f4f7fa; /* Same light background for the content area */
    padding: 10px;
    border-radius: 5px;
}

/* Optional: Style for tab close buttons (if you use them) */
QTabBar::close-button {
    image: url(:/images/close_icon.png); /* Customize with your own close icon */
    subcontrol-position: top right;
}

QTabBar::close-button:hover {
    background-color: #ff4d4d; /* Red color on hover for close button */
}
/* =================================================================
   1. ENABLED STATE (Normal Interaction)
   ================================================================= */

/* Base text styling when active */
QRadioButton {
    font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    color: #000000; /* Pure black text */
    spacing: 10px;
    outline: none;
}

/* Unchecked circle */
QRadioButton::indicator:unchecked {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #888888; /* Mid-gray border for high contrast on light bg */
    background-color: #FFFFFF;
}

/* Hovering over an unchecked button */
QRadioButton::indicator:unchecked:hover {
    border: 2px solid #007BFF; /* Turns blue on hover */
    background-color: #F0F7FF; /* Very subtle blue tint inside */
}

/* Checked state (Blue outer ring + Blue inner dot) */
QRadioButton::indicator:checked {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #007BFF;
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0.0 #007BFF,
        stop: 0.45 #007BFF,
        stop: 0.55 transparent,
        stop: 1.0 transparent
    );
}

/* Hovering over a checked button */
QRadioButton::indicator:checked:hover {
    border: 2px solid #0056B3; /* Darker blue on hover */
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0.0 #0056B3,
        stop: 0.45 #0056B3,
        stop: 0.55 transparent,
        stop: 1.0 transparent
    );
}


/* =================================================================
   2. DISABLED STATE (Grayed Out / Frozen)
   ================================================================= */

/* Grayed out text when disabled */
QRadioButton:disabled {
    color: #A0A0A0; 
}

/* Disabled &amp; Unchecked circle */
QRadioButton::indicator:disabled {
    border: 2px solid #D0D0D0; /* Faded border */
    background-color: #F5F5F5; /* Dull gray background */
}

/* Disabled &amp; Checked circle (If it was selected before being disabled) */
QRadioButton::indicator:checked:disabled {
    border: 2px solid #A0A0A0;
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0.0 #A0A0A0;      /* The inner dot turns gray instead of blue */
        stop: 0.45 #A0A0A0,
        stop: 0.55 transparent,
        stop: 1.0 transparent
    );
}
</string>
