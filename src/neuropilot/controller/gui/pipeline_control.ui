<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1244</width><height>894</height></rect>
  </property>
  <property name="windowTitle">
   <string>NeuroPilot</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ── Workstation theme ──────────────────────────────────────────────── */
QWidget { color: #1B1F24;
          font-family: 'Cantarell','Segoe UI','Noto Sans',sans-serif; }
QMainWindow, QWidget#centralwidget, QWidget[page="true"] { background: #F4F5F7; }
QLabel { background: transparent; }
QGroupBox { background: transparent; }

QTabWidget { background: #FFFFFF; }
QTabWidget::pane { border: 0; background: #F4F5F7; }
QTabBar { background: #FFFFFF; }
QTabBar::tab {
    background: transparent; color: #626B76;
    padding: 11px 18px; margin: 0; border: 0;
    border-bottom: 2px solid transparent;
    font-size: 12px; font-weight: 500;
}
QTabBar::tab:hover { color: #1B1F24; }
QTabBar::tab:selected { color: #1B1F24; font-weight: 600;
                        border-bottom: 2px solid #D97706; }

/* cards */
QGroupBox[card="true"] {
    background: #FFFFFF; border: 1px solid #E2E5E9; border-radius: 6px;
    margin-top: 14px; padding: 14px 14px 12px 14px;
    font-size: 11px; font-weight: 600; color: #626B76;
}
QGroupBox[card="true"]::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    left: 12px; padding: 0 4px 0 4px; background: #FFFFFF;
}

/* text roles */
QLabel[role="cap"]     { font-size: 11px; color: #626B76; }
QLabel[role="value"]   { font-size: 15px; font-weight: 600; }
QLabel[role="value-xl"]{ font-size: 16px; font-weight: 600; }
QLabel[role="section"] { font-size: 11px; font-weight: 600; color: #626B76; }
QRadioButton[role="choice"] { font-size: 12px; color: #3C444D; spacing: 6px; }
QLabel[role="mono"]    { font-family: 'DejaVu Sans Mono','Consolas',monospace;
                         font-size: 12px; color: #3C4A56; }

/* LEDs: status on/off + color green/red (dynamic properties) */
QLabel[led="true"] { min-width: 10px; max-width: 10px; min-height: 10px;
                     max-height: 10px; border-radius: 3px; background: #C9CFD6; }
QLabel[led="true"][status="on"][color="green"] { background: #16A34A; }
QLabel[led="true"][status="on"][color="red"]   { background: #DC2626; }
QLabel[led="true"][status="off"]               { background: #C9CFD6; }

/* buttons */
QPushButton {
    background: #FFFFFF; color: #1B1F24;
    border: 1px solid #D9DDE3; border-radius: 4px;
    padding: 6px 14px; min-height: 20px;
    font-size: 13px; font-weight: 500;
}
QPushButton:hover   { background: #EEF0F2; border-color: #C6CCD4; }
QPushButton:pressed { background: #E2E5E9; }
QPushButton[role="primary"] { background: #D97706; color: #FFFFFF;
                              border: 1px solid #D97706; font-weight: 600;
                              min-height: 28px; padding: 9px 26px; }
QPushButton[role="primary"]:hover { background: #B45309; border-color: #B45309; }
QPushButton[role="danger"]  { background: #FFFFFF; color: #DC2626;
                              border: 1px solid #EBC4C4;
                              min-height: 24px; padding: 7px 18px; }
QPushButton[role="danger"]:hover { background: #FDF3F3; }
QPushButton[role="transport"] { min-height: 24px; padding: 7px 18px; }
QPushButton[role="recover"] { min-height: 16px; padding: 3px 10px; font-size: 11px; }
QPushButton:disabled { background: #F1F3F5; color: #A9B4BE; border-color: #E7EAEE; }
QPushButton[role="primary"]:disabled { background: #EBC79B; color: #FFFFFF;
                                       border-color: #EBC79B; }

QToolButton[role="browse"] {
    background: #FFFFFF; border: 1px solid #D9DDE3; border-radius: 4px;
    padding: 0; min-width: 28px; max-width: 28px; min-height: 28px;
    color: #626B76; font-size: 13px; font-weight: 600;
}
QToolButton[role="browse"]:hover { background: #EEF0F2; color: #1B1F24; }

/* inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF; border: 1px solid #D9DDE3; border-radius: 4px;
    padding: 4px 8px; min-height: 20px; font-size: 13px; color: #1B1F24;
    selection-background-color: #D97706; selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #D97706; padding: 3px 7px;
}
QLineEdit:disabled { background: #F1F3F5; color: #A9B4BE; }
QLineEdit[role="path"] { font-family: 'DejaVu Sans Mono','Consolas',monospace;
                         font-size: 12px; color: #3C4A56; }
QLineEdit[role="name"] { border: 1px solid #D9DDE3; background: #FFFFFF;
                         border-radius: 4px; font-size: 15px; font-weight: 600;
                         color: #1B1F24; padding: 7px 8px; min-height: 24px; }
QLineEdit[role="name"]:focus { border: 2px solid #D97706; padding: 5px 7px; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px; border: 0; background: transparent; }
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox:disabled { color: #A9B4BE; background: #F4F5F7; border-color: #E7EAEE; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #D9DDE3;
    padding: 4px; selection-background-color: #EEF0F2; selection-color: #1B1F24;
    outline: none; }
QComboBox QAbstractItemView::item { min-height: 24px; padding: 2px 6px; }

/* sliders */
QSlider::groove:horizontal { height: 4px; background: #E2E5E9; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #D97706; border-radius: 2px; }
QSlider::handle:horizontal { background: #FFFFFF; border: 2px solid #D97706;
                             border-radius: 7px; width: 14px; margin: -5px 0; }
QSlider::handle:horizontal:hover { background: #FDF3E7; }
QSlider::handle:horizontal:disabled { border-color: #C6CCD4; }

/* toggles */
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px; border: 1px solid #C6CCD4; background: #FFFFFF; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #D97706; border-color: #D97706; }
QCheckBox:disabled, QRadioButton:disabled { color: #A9B4BE; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #F1F3F5; border-color: #E7EAEE; }

/* instrument beds (log, robot view) */
QPlainTextEdit[role="log"] {
    background: #12151A; color: #C9D4DE; border: none; border-radius: 8px;
    font-family: 'DejaVu Sans Mono','Consolas',monospace; font-size: 12px;
    padding: 10px; selection-background-color: #2A333B;
}
QLabel[role="bed"] { background: #12151A; border-radius: 8px; color: #7C8794; }

/* scrollbars */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #C6CCD4; border-radius: 5px;
                              min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #AEB6C0; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0;
                                             background: none; border: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #C6CCD4; border-radius: 5px;
                                min-width: 28px; }

QSplitter::handle { background: #E2E5E9; }
</string>
